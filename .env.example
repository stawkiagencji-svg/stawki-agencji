# Połączenie z bazą PostgreSQL
DATABASE_URL=postgres://opieka:opieka@localhost:5432/opieka

# Hasło do panelu /admin (min. 12 znaków)
ADMIN_PASSWORD=zmien-to-haslo-na-dlugie

# Losowy sekret do podpisywania sesji (np. `openssl rand -hex 32`)
SESSION_SECRET=wstaw-losowy-ciag-64-znakow

# Publiczny adres strony (do metadanych i mapy strony)
NEXT_PUBLIC_SITE_URL=https://twoja-domena.pl

# Ustaw na "true", jeśli baza wymaga SSL (Neon, Supabase, większość chmur)
DATABASE_SSL=false

# Google Play (Trusted Web Activity) – uzupełnij po utworzeniu aplikacji w Play Console
# Nazwa pakietu, np. pl.twojadomena.opieka
ANDROID_PACKAGE_NAME=
# Odcisk SHA-256 klucza podpisu z Play Console (Konfiguracja > Integralność aplikacji).
# Kilka odcisków oddziel przecinkami.
ANDROID_SHA256_FINGERPRINTS=
